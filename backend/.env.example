PORT=3000
NODE_ENV=development

# Agora RTC Credentials (App Certificate stays strictly server-side)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRY_SECONDS=3600

# Firebase Admin Configuration (For cloud platforms e.g. Render, set email & private key env vars)
FIREBASE_PROJECT_ID=connectcall-01
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local development service account file path (optional)
FIREBASE_SERVICE_ACCOUNT_PATH=

