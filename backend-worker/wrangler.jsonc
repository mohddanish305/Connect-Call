{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connectcall-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "AGORA_TOKEN_EXPIRY_SECONDS": "3600",
    "FIREBASE_PROJECT_ID": "connectcall-01",
    "SERVICE_NAME": "ConnectCall Backend"
  },
  "observability": {
    "enabled": true
  }
}
